DATABASE_URL="postgresql://postgres.PROJECT:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_ANON_KEY"
ADMIN_USER_IDS=""
# Opcional: reserve uma execucao por job somente apos aumentar a quota Lambda.
# Contas com quota inicial de 10 execucoes nao permitem essa reserva.
# JOB_RESERVED_CONCURRENCY=1

# Brave para novos projetos. Google Custom Search somente para clientes existentes.
SEARCH_PROVIDER=brave
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
BRAVE_SEARCH_API_KEY=
